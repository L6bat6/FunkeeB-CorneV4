	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		label = "WS2812";

		/* SPI */
		reg = <0>; /* ignored, but necessary for SPI bindings */
		spi-max-frequency = <4000000>;

		/* WS2812 */
		chain-length = <27>; /* There are per-key RGB, but the first 6 are underglow */
		spi-one-frame = <0x70>;
		spi-zero-frame = <0x40>;
		color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
	};
};
*/

/* Example note: to enable underglow on RP2040, implement an RP2040-compatible
   led_strip node (PIO or other). For now, the chosen node remains unchanged
   but the original implementation is commented for safety. */

/ {
	chosen {
		zmk,underglow = &led_strip;
	};
};
